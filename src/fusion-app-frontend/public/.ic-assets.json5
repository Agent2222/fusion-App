[
    {
        "match": ".well-known/ii-alternative-origins",
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*"
        },
        "ignore": false
    },
    {
        "match": "**/*",

        // Provides a base set of security headers that will work for most dapps.
        // Any headers you manually specify will override the headers provided by the policy.
        // See 'dfx info security-policy' to see the policy and for advice on how to harden the headers.
        // Once you improved the headers for your dapp, set the security policy to "hardened" to disable the warning.
        // Options are: "hardened" | "standard" | "disabled".
        "security_policy": "standard",

        // Allow Typekit network connections (momochidori VF.js)
        "headers": {
            // PostHog: script-src + connect-src include https://*.i.posthog.com (events + us-assets…/config.js, surveys.js, etc.)
            // connect-src: S3/R2 presigned PUT uploads go to https://{bucket}.s3.{region}.amazonaws.com or https://*.r2.cloudflarestorage.com
            // media-src: <video>/<audio> from S3 (not covered by img-src; without this, default-src blocks remote media)
            // No upgrade-insecure-requests: on http://*.localhost:4943 (local replica) it can break
            // Internet Identity and other plain-HTTP loads. frame-src includes 127.0.0.1 for II Legacy URL.
            "Content-Security-Policy": "default-src 'self';img-src 'self' data: blob: https://cdn.fusionart.world https://www.facebook.com https://*.s3.us-east-2.amazonaws.com https://*.amazonaws.com https://firebasestorage.googleapis.com;media-src 'self' blob: https://cdn.fusionart.world https://*.s3.us-east-2.amazonaws.com https://*.amazonaws.com https://firebasestorage.googleapis.com;script-src 'self' https://connect.facebook.net https://js.stripe.com https://*.i.posthog.com;worker-src 'self' blob: http://localhost:* http://127.0.0.1:* http://*.localhost:*;frame-src 'self' https://www.facebook.com https://*.facebook.com https://js.stripe.com https://hooks.stripe.com https://m.stripe.network https://b.stripecdn.com https://identity.internetcomputer.org https://identity.ic0.app http://*.localhost:* http://127.0.0.1:*;connect-src 'self' http://localhost:* http://127.0.0.1:* http://*.localhost:* https://cdn.fusionart.world https://icp0.io https://*.icp0.io https://icp-api.io https://identity.internetcomputer.org https://identity.ic0.app https://use.typekit.net https://*.typekit.net https://connect.facebook.net https://graph.facebook.com https://fusion-app-sycs.onrender.com https://www.fusionart.world https://fusionart.world https://www.facebook.com https://*.facebook.com https://*.amazonaws.com https://*.r2.cloudflarestorage.com https://api.stripe.com https://r.stripe.com https://m.stripe.network https://hooks.stripe.com https://merchant-ui-api.stripe.com https://*.i.posthog.com;style-src * 'unsafe-inline';style-src-elem * 'unsafe-inline';font-src *;object-src 'none';base-uri 'self';frame-ancestors 'none';form-action 'self';"
        },

        // Uncomment to disable the warning about using the
        // standard security policy, if you understand the risk
        // "disable_security_policy_warning": true,

        // Uncomment to redirect all requests from .raw.icp0.io to .icp0.io
        // "allow_raw_access": false
    },
]
