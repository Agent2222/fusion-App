[
    {
        "match": ".well-known/ii-alternative-origins",
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*"
        },
        "ignore": false
    },
    {
        "match": "**/*",
        "security_policy": "standard",

        "headers": {
            "Content-Security-Policy": "default-src 'self';img-src 'self' data: blob: https://cdn.fusionart.world https://www.facebook.com https://*.s3.us-east-2.amazonaws.com https://*.amazonaws.com https://firebasestorage.googleapis.com https://*.paypal.com https://*.paypalobjects.com;media-src 'self' blob: https://cdn.fusionart.world https://*.s3.us-east-2.amazonaws.com https://*.amazonaws.com https://*.r2.cloudflarestorage.com https://firebasestorage.googleapis.com;script-src 'self' https://connect.facebook.net https://js.stripe.com https://*.i.posthog.com https://www.paypal.com https://*.paypal.com https://*.paypalobjects.com;worker-src 'self' blob: http://localhost:* http://127.0.0.1:* http://*.localhost:*;frame-src 'self' https://www.facebook.com https://*.facebook.com https://js.stripe.com https://hooks.stripe.com https://m.stripe.network https://b.stripecdn.com https://identity.internetcomputer.org https://identity.ic0.app http://*.localhost:* http://127.0.0.1:* https://www.paypal.com https://*.paypal.com https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://youtube-nocookie.com;connect-src 'self' http://localhost:* http://127.0.0.1:* http://*.localhost:* https://cdn.fusionart.world https://icp0.io https://*.icp0.io https://icp-api.io https://identity.internetcomputer.org https://identity.ic0.app https://use.typekit.net https://*.typekit.net https://connect.facebook.net https://graph.facebook.com https://fusion-app-sycs.onrender.com https://www.fusionart.world https://fusionart.world https://www.facebook.com https://*.facebook.com https://*.amazonaws.com https://*.r2.cloudflarestorage.com https://api.stripe.com https://r.stripe.com https://m.stripe.network https://hooks.stripe.com https://merchant-ui-api.stripe.com https://*.i.posthog.com https://www.paypal.com https://*.paypal.com https://api-m.paypal.com https://api-m.sandbox.paypal.com;style-src * 'unsafe-inline';style-src-elem * 'unsafe-inline';font-src *;object-src 'none';base-uri 'self';frame-ancestors 'none';form-action 'self';",
            "Cache-Control": "public, max-age=0, must-revalidate"
        },

        // Redirect .raw.icp0.io requests to the certified endpoint.
        // Prevents Google from indexing the raw canister URL as a duplicate.
        "allow_raw_access": false,

        // SPA fallback: serve index.html for any route without a matching file.
        // Required so Googlebot (and direct links) get the app shell for all routes.
        "enable_aliasing": true
    },
    {
        // Hashed static assets: cache aggressively (fingerprinted filenames).
        "match": "assets/**/*",
        "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
        }
    },
]
