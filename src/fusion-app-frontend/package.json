{
  "name": "fusion-app-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm i && dfx canister create fusion-app-backend && env NO_COLOR=1 dfx generate fusion-app-backend && dfx deploy",
    "start": "vite --port 3000",
    "prebuild": "env NO_COLOR=1 dfx generate fusion-app-backend && env NO_COLOR=1 dfx generate fusion-radar",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "cross-fetch": "^3.1.6",
    "dotenv": "^16.3.1",
    "sass": "^1.63.6",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@dfinity/agent": "^3.0.0",
    "@dfinity/auth-client": "^3.4.3",
    "@dfinity/candid": "^3.0.0",
    "@dfinity/principal": "^3.0.0",
    "@stripe/stripe-js": "^4.10.0",
    "html2canvas": "^1.4.1",
    "lit-html": "^2.8.0",
    "posthog-js": "^1.369.0"
  }
}
