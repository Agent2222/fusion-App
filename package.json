{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "fusion-app",
  "scripts": {
    "backup": "bash scripts/backup.sh",
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "integration-api": "npm run dev --workspace=fusion-integration-api",
    "integration-api:start": "npm start --workspace=fusion-integration-api"
  },
  "type": "module",
  "workspaces": [
    "src/fusion-app-frontend",
    "services/fusion-integration-api"
  ],
  "dependencies": {
    "gsap": "^3.14.2"
  }
}
